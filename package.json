{
  "name": "school-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack School Management System built as a modular monolith",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build --workspace=packages/shared",
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "docker:db:up": "docker-compose -f infra/docker-compose.yml up -d db db-test",
    "docker:db:down": "docker-compose -f infra/docker-compose.yml down",
    "docker:db:wait": "node scripts/wait-for-mongo.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

