# Application Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Database (MongoDB Replica Set)
MONGODB_URI=mongodb://localhost:27017/school_management?replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/school_management_test?replicaSet=rs0

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-secure-refresh-token-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-cookie-secret

# Attendance Configuration
ATTENDANCE_EDIT_WINDOW_DAYS=2

# School Configuration
SCHOOL_TIMEZONE=Asia/Kolkata

