{
  "openapi": "3.1.0",
  "info": {
    "title": "School Management System API",
    "version": "1.0.0",
    "description": "Production REST API for school operations with role-based access control, attendance tracking, grading engine, and financial ledger."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authorization header using the Bearer scheme or httpOnly auth_token cookie"
      }
    },
    "schemas": {
      "HealthCheckResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "uptime": {
            "type": "number"
          },
          "service": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "database": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "connected",
                  "disconnected",
                  "connecting"
                ]
              },
              "replicaSet": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "status",
          "timestamp",
          "uptime",
          "service",
          "environment",
          "version",
          "database"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "TEACHER",
                  "GUARDIAN"
                ]
              },
              "fullName": {
                "type": "string"
              },
              "teacherId": {
                "type": "string"
              },
              "guardianId": {
                "type": "string"
              },
              "isActive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "role",
              "fullName",
              "isActive"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "user"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "StudentQuery": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "q": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "GRADUATED"
            ]
          }
        }
      },
      "StudentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "admissionNo": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "dob": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "GRADUATED"
            ]
          },
          "currentSection": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "className": {
                "type": "string"
              },
              "rollNo": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "className"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "admissionNo",
          "fullName",
          "dob",
          "gender",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "StudentDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "admissionNo": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "dob": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "GRADUATED"
            ]
          },
          "currentSection": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "className": {
                "type": "string"
              },
              "rollNo": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "className"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "guardians": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "fullName": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string"
                },
                "isPrimary": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "fullName",
                "phone",
                "relationship",
                "isPrimary"
              ]
            }
          },
          "enrollmentHistory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "academicYear": {
                  "type": "string"
                },
                "className": {
                  "type": "string"
                },
                "sectionName": {
                  "type": "string"
                },
                "rollNo": {
                  "type": "integer"
                }
              },
              "required": [
                "academicYear",
                "className",
                "sectionName",
                "rollNo"
              ]
            }
          }
        },
        "required": [
          "id",
          "admissionNo",
          "fullName",
          "dob",
          "gender",
          "status",
          "createdAt",
          "updatedAt",
          "guardians",
          "enrollmentHistory"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "API Health Probe",
        "description": "Returns the operational health, database replica set status, and uptime of the API service.",
        "tags": [
          "Observability"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy or degraded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded",
                        "down"
                      ]
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "uptime": {
                      "type": "number"
                    },
                    "service": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "database": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "connected",
                            "disconnected",
                            "connecting"
                          ]
                        },
                        "replicaSet": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "uptime",
                    "service",
                    "environment",
                    "version",
                    "database"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "API Readiness Probe",
        "description": "Returns HTTP 200 when database connection is established; HTTP 503 otherwise.",
        "tags": [
          "Observability"
        ],
        "responses": {
          "200": {
            "description": "Service ready"
          },
          "503": {
            "description": "Service not ready"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "User Login",
        "description": "Authenticates a user via email and password, setting an httpOnly JWT cookie.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "ADMIN",
                            "TEACHER",
                            "GUARDIAN"
                          ]
                        },
                        "fullName": {
                          "type": "string"
                        },
                        "teacherId": {
                          "type": "string"
                        },
                        "guardianId": {
                          "type": "string"
                        },
                        "isActive": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "role",
                        "fullName",
                        "isActive"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials, account locked, or deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "number"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "detail",
                    "requestId"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for login attempts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "number"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "detail",
                    "requestId"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "User Logout",
        "description": "Clears the authentication cookie and ends the session.",
